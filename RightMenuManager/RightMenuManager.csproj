<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      高 DPI 必须在这里声明。只在代码里调 Application.SetHighDpiMode 是不够的：
      那个设置要在进程极早期生效，晚了就无效，程序会被系统当成「不支持高分屏」，
      整个界面由系统拉伸位图糊出来 —— 又模糊、尺寸也算错。
      写在这里会进 runtimeconfig，进程一启动就生效。
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Microsoft YaHei UI, 9pt</ApplicationDefaultFont>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>右键菜单管理器</AssemblyName>
    <RootNamespace>RightMenuManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Windows 11 右键菜单管理器</Product>
    <AssemblyTitle>Windows 11 右键菜单管理器</AssemblyTitle>
    <Company>本地工具</Company>
    <Copyright>本机使用</Copyright>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
